/**
 * @name Background Only – Image Layer
 * @author Purple_Ξye™
 * @description Adds a background image without changing Discord colors.
 */

:root {
  --bg-image: url("PASTE_IMAGE_URL_HERE");
  --bg-overlay: rgba(0, 0, 0, 0.6);
  --bg-blur: 0px;
}

/* Main app background */
.appMount-2yBXZl,
.app-2CXKsg {
  background:
    linear-gradient(var(--bg-overlay), var(--bg-overlay)),
    var(--bg-image) !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  backdrop-filter: blur(var(--bg-blur));
}

/* Make layers transparent so background shows */
.layers-3iHuyZ,
.layer-86YKbF,
.container-2cd8Mz,
.chat-2ZfjoI,
.sidebar-1tnWFu {
  background: transparent !important;
}